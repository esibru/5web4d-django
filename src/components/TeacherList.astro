---
import { teachers } from "../data/teachers.js";
---

<ul>
  {teachers.map((teacher) => (
    <li>
      <header>
        {teacher.trigram}
      </header>

      <main>
        <strong>
          <a
            href={teacher.webPage}
            class="name-link"
          >
            {teacher.firstName} {teacher.lastName}
          </a>
        </strong>

        <a class="mail" href={`mailto:${teacher.email}`}>
          {teacher.email}
        </a>
      </main>
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1.5rem;

    list-style: none;
    padding: 0;
  }

  ul li {
    position: relative;

    padding: 1rem;

    border-radius: 10px;
    box-shadow: rgba(149, 157, 165, 0.2) 0 8px 24px;

    transition: box-shadow 500ms;

    header {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 3em;
      height: 3em;
      margin: 0 auto 10px;

      font-size: 1.2em;

      color: #ddd;
      background-color: #333;
      border: 2px solid transparent;
      border-radius: 50%;

      transition:
        border-color 1000ms,
        background-color 200ms;
    }

    main {
      display: flex;
      flex-direction: column;
      text-align: center;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .name-link::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .mail {
      position: relative;
      z-index: 1;

      &:hover {
        color: #888;
        text-decoration: underline;
      }
    }

    &:hover {
      box-shadow: rgba(100, 100, 111, 0.2) 0 7px 29px 0;

      header {
        background-color: #666;
        border-color: #ddd;
      }
    }
  }
</style>